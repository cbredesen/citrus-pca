# Comma-separated public iCal URLs (Google Calendar, Outlook, etc.)
ICAL_URLS=https://calendar.google.com/calendar/ical/YOUR_CALENDAR_ID/public/basic.ics

# Server port
PORT=3000

# Optional: override database path (default: ./data/mail-minder.db)
# DB_PATH=/app/data/mail-minder.db

# Optional: override templates directory (default: ./templates)
# TEMPLATES_DIR=/app/templates
