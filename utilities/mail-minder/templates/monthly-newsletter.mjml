<mjml>
  <mj-head>
    <mj-title>{{club_name}} — {{month_year}} Newsletter</mj-title>
    <mj-preview>Your {{month_year}} update from {{club_name}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.6" color="#1e293b" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#f1f5f9">

    <!-- Header -->
    <mj-section background-color="#1d4ed8" padding="28px 0">
      <mj-column>
        <mj-text align="center" color="#bfdbfe" font-size="12px" font-weight="bold" letter-spacing="2px" text-transform="uppercase">
          {{club_name}}
        </mj-text>
        <mj-text align="center" color="#ffffff" font-size="26px" font-weight="bold" padding-top="6px">
          {{month_year}} Newsletter
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- President's Note -->
    <mj-section background-color="#ffffff" padding="32px 24px 16px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#1d4ed8">From the President</mj-text>
        <mj-divider border-color="#e2e8f0" border-width="1px" padding="8px 0" />
        <mj-text>{{president_message}}</mj-text>
        <mj-text padding-top="8px" color="#64748b" font-size="13px">— {{president_name}}, President</mj-text>
      </mj-column>
    </mj-section>

    <!-- Featured Event -->
    <mj-section background-color="#eff6ff" padding="24px">
      <mj-column>
        <mj-text font-size="12px" font-weight="bold" letter-spacing="2px" text-transform="uppercase" color="#1d4ed8">
          Featured Event
        </mj-text>
        <mj-text font-size="20px" font-weight="bold" padding-top="4px">{{featured_event_name}}</mj-text>
        <mj-text color="#64748b" font-size="14px">{{featured_event_date}} &bull; {{featured_event_location}}</mj-text>
        <mj-text padding-top="8px">{{featured_event_description}}</mj-text>
        <mj-button background-color="#1d4ed8" color="#ffffff" border-radius="6px"
                   padding="12px 24px" href="{{featured_event_url}}">
          Learn More
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Upcoming Events -->
    <mj-section background-color="#ffffff" padding="24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#1d4ed8">Upcoming Events</mj-text>
        <mj-divider border-color="#e2e8f0" border-width="1px" padding="8px 0" />
        <mj-text>{{upcoming_events}}</mj-text>
      </mj-column>
    </mj-section>

    <!-- Member Spotlight -->
    <mj-section background-color="#f0fdf4" padding="24px">
      <mj-column>
        <mj-text font-size="12px" font-weight="bold" letter-spacing="2px" text-transform="uppercase" color="#16a34a">
          Member Spotlight
        </mj-text>
        <mj-text font-size="18px" font-weight="bold" padding-top="4px">{{spotlight_name}}</mj-text>
        <mj-text>{{spotlight_story}}</mj-text>
      </mj-column>
    </mj-section>

    <!-- Classifieds / For Sale -->
    <mj-section background-color="#ffffff" padding="24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#1d4ed8">Classifieds</mj-text>
        <mj-divider border-color="#e2e8f0" border-width="1px" padding="8px 0" />
        <mj-text>{{classifieds}}</mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#f8fafc" padding="24px" border-top="1px solid #e2e8f0">
      <mj-column>
        <mj-text align="center" color="#94a3b8" font-size="12px">
          {{club_name}} &bull; {{club_website}}<br />
          To unsubscribe or update your preferences, reply to this email.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
