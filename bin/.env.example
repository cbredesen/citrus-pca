# bin/.env — copy this to bin/.env and fill in your values
# This file is sourced by pull-prod.sh. Never commit bin/.env.

# FTP credentials for flc.pca.org
FTP_HOST="flc.pca.org"
FTP_USER=""
FTP_PASS=""

# Path on the FTP server where UpdraftPlus stores backups.
# Commonly /public_html/wp-content/updraft or /wp-content/updraft
REMOTE_BACKUP_DIR="/public_html/wp-content/updraft"

# Use ftps (FTP over TLS) or plain ftp. Set to "ftp" if the server
# doesn't support TLS. Values: ftps | ftp
FTP_SCHEME="ftps"

# Absolute path to the root of your Local site (contains wp-config.php)
# Typically: ~/Local Sites/<site-name>/app/public
LOCAL_SITE_ROOT="${HOME}/Local Sites/flc-pca/app/public"

# URLs to swap in the database after import
PROD_URL="https://flc.pca.org"
LOCAL_URL="http://flc-pca.local"

# Path to wp-cli. "wp" works if it's on your PATH.
# Local's bundled wp-cli: run the script from Local's site shell, or set this
# to the full path printed by: which wp
WP_CLI="wp"
